# Copy to .env and fill in only the providers you use. Never commit .env.

# Hosted providers (free tiers: Groq, NVIDIA build.nvidia.com, Gemini AI Studio)
OPENAI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=

# Local models via Ollama (no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Provider used by /api/ask when none is given: mock | ollama | groq | openai | ...
MEDSHIELD_DEFAULT_PROVIDER=mock

# Optional LLM judge for incorrectness, e.g. groq/llama-3.3-70b-versatile (empty = heuristics only)
MEDSHIELD_JUDGE=

# Policy thresholds on FSC
MEDSHIELD_WARN_AT=0.08
MEDSHIELD_REWRITE_AT=0.18
MEDSHIELD_BLOCK_AT=0.35

# Localised safety messaging
MEDSHIELD_EMERGENCY_NUMBER=112
MEDSHIELD_CRISIS_LINE=Tele-MANAS 14416 (India)

# ---- Public deployment ----
# Protects the audit log (users' questions) and the /v1 proxy. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MEDSHIELD_ADMIN_TOKEN=
# Providers visitors may use, e.g. mock,groq (empty = all configured)
MEDSHIELD_ALLOWED_PROVIDERS=
# Model calls per visitor IP per hour (0 = unlimited)
MEDSHIELD_RATE_LIMIT_PER_HOUR=0
